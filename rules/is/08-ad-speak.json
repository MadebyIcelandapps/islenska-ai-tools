{
 "_comment": "Sales clichés and hype, mostly copied from English ads. Format: see README. basis: native = recent Icelandic text backs the rule (counts in rules/evidence.json); house = the product owner's decision; grammar = standard spelling and grammar.",
 "group": "ad-speak",
 "rules": [
  {
   "id": "vegferd",
   "group": "ad-speak",
   "why": "'Vegferð' is corporate jargon. Say what happens.",
   "pattern": "{LB}vegferð\\p{L}*",
   "scope": "product",
   "severity": "warning",
   "suggest": "say what happens",
   "basis": "native",
   "origin": "ai",
   "evidence": {
    "flagged": "[lemma=\"vegferð\"]",
    "natural": "[lemma=\"leið\"]"
   },
   "examples": {
    "bad": [
     "Vertu með okkur á þessari vegferð."
    ],
    "good": [
     "Vertu með."
    ]
   }
  },
  {
