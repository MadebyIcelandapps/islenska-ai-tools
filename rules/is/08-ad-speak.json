   "severity": "warning",
   "suggest": "say what it is",
   "basis": "native",
   "origin": "ai",
   "evidence": {
    "flagged": "[word=\"spennandi\" %c][word=\"tækifæri\" %c]",
    "natural": "[word=\"gott\" %c][word=\"tækifæri\" %c]"
