   "scope": "product",
   "severity": "warning",
   "suggest": "Kynntu þér, Skoðaðu",
   "basis": "native",
   "origin": "ai",
   "evidence": {
    "flagged": "[word=\"uppgötvaðu\" %c]",
    "natural": "[word=\"kynntu\" %c][word=\"þér\" %c]"
   },
   "examples": {
