  },
  {
   "id": "fragment-triplet",
   "group": "ad-speak",
   "why": "Three one-word sentences in a row ('Rautt ljós. Sveitt. Alvöru.') is a copywriting tic.",
   "pattern": "(?:^|[.!?]\\s+)\\p{Lu}\\p{L}*(?:\\s\\p{L}+)?\\.\\s+\\p{Lu}\\p{L}*\\.\\s+\\p{Lu}\\p{L}*\\.",
   "flags": "u",
   "scope": "product",
   "severity": "error",
   "suggest": "one full sentence",
   "basis": "house",
   "origin": "owner",
   "examples": {
    "bad": [
     "Rautt ljós. Sveitt. Alvöru."
    ],
    "good": [
     "Heitur salur og heit ljós."
    ]
   }
  },
  {
   "id": "negation-list",
   "group": "ad-speak",
   "why": "A run of 'Ekki X, ekki Y, ekki Z' reads like a disclaimer. Say what it does.",
   "pattern": "{LB}ekki\\s+\\p{L}+,\\s+ekki\\s+\\p{L}+(?:,|\\s+og|\\s+eða)\\s+ekki\\s+\\p{L}+",
   "scope": "product",
   "severity": "error",
   "suggest": "say what it does",
   "basis": "house",
   "origin": "owner",
   "examples": {
    "bad": [
     "Ekki verð, ekki aldurstakmark, ekki tíma."
    ],
    "good": [
     "Hann svarar um verð og tíma."
    ]
   }
  }
 ]
