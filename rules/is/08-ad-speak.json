   "severity": "warning",
   "suggest": "say what you do",
   "basis": "native",
   "origin": "ai",
   "evidence": {
    "flagged": "[word=\"leiðandi\" %c][word=\"fyrirtæki\" %c]",
    "natural": "[word=\"fyrirtæki\" %c][word=\"í\" %c]"
