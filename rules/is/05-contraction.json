  {
   "id": "uncontracted-vilt",
   "group": "contraction",
   "why": "In a question 'Vilt þú' sounds stiff or translated. Everyday Icelandic writes 'Viltu'.",
   "pattern": "(?:^|[.!?]\\s+|,\\s*)vilt\\s+þú(?=\\s+\\p{L}+[^.!?]*\\?)",
   "scope": "all",
   "severity": "warning",
   "suggest": "Viltu",
   "replace": {
    "vilt þú": "viltu"
   },
   "basis": "native",
   "origin": "ours",
   "evidence": {
    "flagged": "[word=\"vilt\" %c][word=\"þú\"]",
    "natural": "[word=\"viltu\" %c]"
   },
   "examples": {
    "bad": [
     "Vilt þú bóka herbergi?"
    ],
    "good": [
     "Viltu bóka herbergi?"
    ]
   }
  },
