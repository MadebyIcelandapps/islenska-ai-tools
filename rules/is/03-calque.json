   "scope": "all",
   "severity": "warning",
   "suggest": "á síðunni þinni",
   "basis": "native",
   "origin": "ours",
   "evidence": {
    "flagged": "[word=\"á\" %c][word=\"þinni\" %c][word=\"síðu\" %c]",
    "natural": "[word=\"á\" %c][word=\"síðunni\" %c][word=\"þinni\" %c]"
   },
   "examples": {
    "bad": [
     "Spjall á þinni síðu.",
     "Hann svarar út frá þínum upplýsingum."
    ],
    "good": [
     "Spjall á síðunni þinni.",
     "Hann svarar eftir upplýsingunum þínum."
    ]
   }
  },
